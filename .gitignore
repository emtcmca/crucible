# Secrets — never commit
.env
.env.*
!.env.example
*service-account*.json
*credentials*.json
*.pem
*.key

# The Day-1 spike is throwaway; it must not become part of the record
spike/

# Run evidence is written at runtime, never hand-edited.
# Curated bundles that back a published claim are force-added deliberately:
#   git add -f evidence/runs/<date>-<slug>/
evidence/
!evidence/.gitkeep

# THE SEALED HELD-OUT FAMILY.
# NOTE: a .gitignore entry is NOT the control. The real boundary is IAM —
# the Armorer's service account holds no read on the sealed GCS bucket.
# This line only stops an accidental local commit. See CONVENTIONS.md §9.
corpus/sealed/

# Local third-party checkouts (targets under test are cloned to scratch, not here)
adk-samples/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Competitive and promotion strategy. Moved out when the repo went public
# 2026-08-20. Every other doc describes the system; this one describes the
# contest. Not secret, just not part of the artifact.
planning/

# Local Claude Code settings (per-machine preferences, not project policy).
# Holds the crucible-scoped caveman disable set 2026-08-21.
.claude/settings.local.json

# Agent worktrees. Each is a FULL CHECKOUT of this repository, so a single
# `git add -A` would commit whole copies of the tree into the tree. The standing
# rule is to stage by explicit path and never `-A`, and this is the guard for the
# day somebody does it anyway. Added 2026-08-25 after four lanes ran at once.
.claude/worktrees/

# Cloud Run deploy staging tree. Derived from target/ by deploy/build-stage.py
# and rebuilt every deploy - a committed copy would be a second source of truth
# for the frozen target.
deploy/.stage/

# Diagram render artifacts and local tool config. Sources are tracked; renders are not.
docs/diagrams/*.png
docs/diagrams/*.render.log
docs/diagrams/*.exitcode
pptr-config.json

# Video capture tooling: node deps and rendered frames are large and derived.
tools/capture/node_modules/
tools/capture/out/
tools/capture/package-lock.json

# Narration takes are large binaries and are not repo content.
# The README stays: it is how the next person knows what goes here.
audio/*
!audio/README.md

# Live-shot footage: large binaries, not repo content. The README stays.
video/*
!video/README.md
